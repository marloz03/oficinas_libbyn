# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo .env a git (ya está ignorado en .gitignore).

# API key de Gather.town -> https://gather.town -> menú de usuario -> "API Keys"
# (o https://developers.gather.town). Es un texto largo, NO tu contraseña.
GATHER_API_KEY=

# ID de tu espacio (space) de Gather.
# Lo ves en la URL cuando entras al space:
#   https://app.gather.town/app/XXXXXXXXXXXX/NombreDelEspacio
# El space id es la parte:  XXXXXXXXXXXX\NombreDelEspacio  (con barra invertida)
# Ejemplo:  GATHER_SPACE_ID=AbCd1234efGh\TribuDatos
GATHER_SPACE_ID=

# Token de tu suscripción Claude (Pro/Max), NO una API key de pago.
# Se genera en tu computadora con Claude Code:  claude setup-token
# (ver README.md, sección "Conseguir tu token de Claude"). Empieza con sk-ant-oat...
CLAUDE_CODE_OAUTH_TOKEN=

# --- Modo programador (opcional) ---
# Repositorio donde el bot programa. Si lo dejas vacío, el bot solo conversa.
REPO_URL=https://github.com/marloz03/Libbyn.git
# Carpeta local donde clonar/trabajar el repo. Por defecto: ./workspace/Libbyn
REPO_DIR=
